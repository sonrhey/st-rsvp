{
  "name": "son-rhey-therese-invitation",
  "main": "cloudflare.js",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "wedding-rsvp-backups"
    }
  ]
}